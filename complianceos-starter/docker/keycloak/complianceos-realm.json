{
  "realm": "complianceos",
  "enabled": true,
  "displayName": "ComplianceOS",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "accessTokenLifespan": 28800,
  "ssoSessionMaxLifespan": 2592000,
  "clients": [
    {
      "clientId": "complianceos-api",
      "name": "ComplianceOS API",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-secret-change-in-prod",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:3000/*", "http://localhost:8080/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:8080"],
      "protocolMappers": [
        {
          "name": "tenant-id-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tenant_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "complianceos-frontend",
      "name": "ComplianceOS Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"]
    }
  ],
  "roles": {
    "client": {
      "complianceos-api": [
        { "name": "ADMIN",            "description": "Full read/write access" },
        { "name": "AUDITOR",          "description": "Read/write audits" },
        { "name": "VIEWER",           "description": "Read-only access" },
        { "name": "EXTERNAL_AUDITOR", "description": "Read shared audits only" }
      ]
    }
  }
}